# --- Python (illustrative placeholder only — no language has been chosen;
# --- see README.md "Technology Roadmap") ---
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
.eggs/
build/
dist/
.installed.cfg

# --- Virtual environments ---
.venv/
venv/
env/
ENV/

# --- Notebooks ---
.ipynb_checkpoints/

# --- Environment and secrets ---
.env
.env.*
!.env.example
*.key
*.pem
secrets.*

# --- Data ---
# Client and evidence data is confidential by default. Only explicitly
# whitelisted sample data (data/samples/) should ever be committed.
data/input/*
data/output/*
!data/input/.gitkeep
!data/output/.gitkeep

# Real client audit workspaces (created by src/create_audit.py) and their
# reports stay local. Only the Boots UK demonstration audit is committed.
audits/*
!audits/boots-uk-health-beauty/
!audits/boots-uk-health-beauty/**
# Full raw AI answers (src/run_structured_batch_audit.py) are never
# committed at any depth, and audit snapshots (src/audit_history.py) are
# never committed - including for the Boots demonstration audit. Must
# follow the Boots exceptions above. (The v2.3 rule audits/*/raw_responses/
# is kept; it is a subset of the v2.4 audits/**/raw_responses/ rule.)
audits/*/raw_responses/
audits/**/raw_responses/
audits/*/snapshots/
# The recurring-monitoring lock (src/run_monitoring_cycle.py) is local
# process state, never committed - including for the Boots audit.
audits/*/.monitoring.lock
reports/*
!reports/boots-uk-health-beauty/
!reports/boots-uk-health-beauty/**
# Run comparison outputs are derived and never committed.
reports/*/comparisons/

# --- Testing and coverage ---
.pytest_cache/
.coverage
htmlcov/
.tox/

# --- Editor and OS files ---
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- Logs ---
*.log
